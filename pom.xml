<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.digitalstables</groupId>
  <artifactId>pauladeployer</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>PaulaDeployer</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <!-- Same deploy-on-package pattern as the factory webapp's own pom.xml and
         ~/Data/Aquabubbler/software/lucille's - server.user is Paula's OS user (confirmed "pi"
         from bench sessions), not this dev machine's. -->
    <server.address>paula2.local</server.address>
    <server.user>pi</server.user>
    <private.key>/home/ari/.ssh/chilhuacle</private.key>
  </properties>

  <dependencies>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20160810</version>
    </dependency>
    <dependency>
      <!-- 42.1.1 (2017) is what the rest of this codebase pins, but it predates SCRAM-SHA-256
           support entirely - confirmed 2026-09-05: every deployAttempt query failed with
           "authentication type 10 is not supported", since this Paula's local Postgres (a fresh
           install on Trixie) defaults new roles to scram-sha-256, unlike the older servers most
           of this codebase's 42.1.1 connections talk to. SCRAM support landed in 42.2.0+; using
           the same modern version FactorySystem/AIConnectorApp already uses successfully. -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.7</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-dbcp2</artifactId>
      <version>2.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.4</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.4</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.19.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.19.0</version>
    </dependency>
    <dependency>
      <groupId>com.fazecast</groupId>
      <artifactId>jSerialComm</artifactId>
      <version>2.11.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>ROOT</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.3.2</version>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
      <!-- =========================================== -->
      <!-- scp the built WAR straight to Paula's Tomcat on package/install - same pattern as
           the factory webapp's own pom.xml and ~/Data/Aquabubbler/software/lucille's. Ant's scp
           task (not the OS's scp binary), backed by JSch. Uses com.github.mwiede:jsch, not
           com.jcraft:jsch - the older one can't authenticate against a modern OpenSSH server
           (like Paula's Trixie sshd) that disables the legacy ssh-rsa/SHA-1 signature algorithm
           by default, which chilhuacle (an RSA key) needs - hit and fixed for exactly this
           reason in the factory webapp's own runtime dependency, see the design doc §13.1. Must
           come after maven-war-plugin in this list so the WAR already exists when this runs.

           Confirmed gotcha (2026-09-10): running plain "mvn package" ON Paula itself (not from a
           dev machine) used to always hit the scp below, which fails with a JSch error looking
           for private.key at /home/ari/.ssh/... - that path only exists on Ari's own dev
           machine, not on the Pi (user "pi", home /home/pi). It's also pointless to SSH into a
           machine to copy a file to itself. provision-pi.sh avoids this by building with
           -Dmaven.antrun.skip=true and cp'ing locally instead.

           First attempt at fixing this used a Maven profile (activated by
           /home/pi/pauladeployer/tomcat/webapps existing locally) declaring a second execution
           with the same id "scp-to-paula", expecting Maven to merge/override the base
           execution's config. Confirmed BROKEN in practice (2026-09-10, live on paula2): BOTH
           executions ran - the local copy succeeded, then the base scp execution also ran and
           failed the whole build (verified against the real bench Pi, not just inferred from the
           pom). So instead this all lives in ONE execution/target, using Ant's per-TASK if/unless
           attributes (core Ant since 1.9.1 - antrun 1.8 bundles Ant 1.9.4, confirmed via this
           project's own resolved dependency, so it's available) to pick copy vs scp at runtime -
           no separate execution, no profile-merge behavior to rely on. -->
      <!-- =========================================== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>1.8</version>
        <executions>
          <execution>
            <id>scp-to-paula</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <condition property="onPaulaPi">
                  <available file="/home/pi/pauladeployer/tomcat/webapps" type="dir" />
                </condition>
                <echo message="Building on Paula itself - copying WAR locally instead of scp." if="onPaulaPi" />
                <copy file="${project.build.directory}/ROOT.war" tofile="/home/pi/pauladeployer/tomcat/webapps/ROOT.war" overwrite="true" if="onPaulaPi" />
                <!-- keyfile+passphrase or password, choose one -->
                <scp localFile="${project.build.directory}/ROOT.war"
                  remoteToFile="${server.user}@${server.address}:/home/pi/pauladeployer/tomcat/webapps/ROOT.war"
                  verbose="true"
                  keyfile="${private.key}"
                  passphrase=""
                  trust="true"
                  unless="onPaulaPi">
                </scp>
              </target>
            </configuration>
          </execution>
        </executions>
        <!-- libraries for scp impl - antrun doesn't use the OS's scp -->
        <dependencies>
          <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <version>0.2.17</version>
          </dependency>
          <dependency>
            <groupId>ant</groupId>
            <artifactId>ant-jsch</artifactId>
            <version>1.6.5</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- =========================================== -->
      <!--   antrun plugin end                         -->
      <!-- =========================================== -->
    </plugins>
  </build>
</project>
